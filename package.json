{
  "name": "racegpt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A browser-playable 3D time-attack racing MVP.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "smoke:sim": "tsx scripts/smoke-sim.ts",
    "test:car-physics": "tsx scripts/car-physics-tests.ts",
    "test:drivers": "tsx scripts/driver-variant-tests.ts",
    "test:runtime": "tsx scripts/runtime-tests.ts",
    "test:pb-replay": "tsx scripts/pb-replay-tests.ts",
    "test": "npm run test:car-physics && npm run test:drivers && npm run test:pb-replay && npm run test:runtime",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.165.0"
  },
  "devDependencies": {
    "@types/three": "^0.184.1",
    "tsx": "^4.22.3",
    "typescript": "^5.4.5",
    "vite": "^8.0.14"
  }
}
